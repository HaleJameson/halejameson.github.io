---
import Layout from '../../layouts/Layout.astro';
import ComingSoonCard from '../../components/ComingSoonCard.astro';

---

<Layout title="Projects" description="Selected AI/ML and software engineering projects">
  <h1>Projects</h1>
  <p class="muted">Selected AI/ML and software engineering work</p>
  <div class="grid">
    <ComingSoonCard />
    <ComingSoonCard />
    <ComingSoonCard />
  </div>
</Layout>

<style>
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); margin-top: 1.5rem; }
</style>
