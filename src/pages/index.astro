---
import Layout from '../layouts/Layout.astro';
import ComingSoonCard from '../components/ComingSoonCard.astro';
import { SITE } from '../site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <section class="hero">
    <p class="muted">Hi, I'm</p>
    <h1>{SITE.shortName}</h1>
    <p class="role">{SITE.role}</p>
    <p class="muted tagline">{SITE.tagline}</p>
    <p class="now"><span class="dot" aria-hidden="true"></span><strong>Now:</strong> {SITE.now}</p>
    <p class="actions">
      <a class="button primary" href={`${base}/projects`}>View projects</a>
      <a class="button" href={SITE.github}>GitHub</a>
      <a class="button" href={SITE.linkedin}>LinkedIn</a>
    </p>
  </section>

  <h2>Projects</h2>
  <div class="grid">
    <ComingSoonCard />
    <ComingSoonCard />
  </div>
</Layout>

<style>
  .hero { padding: 2rem 0 1rem; }
  .hero p { margin: 0.25rem 0; }
  .role { font-size: 1.3rem; font-weight: 600; }
  .tagline { max-width: 36rem; }
  .now {
    display: inline-flex; align-items: center; gap: 0.55rem; margin-top: 1rem !important; padding: 0.3rem 0.9rem;
    font-size: 0.9rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface);
  }
  .now strong { color: var(--accent); font-weight: 600; }
  .dot { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: #e2be5a; box-shadow: 0 0 8px #e2be5a; animation: blink 2.4s ease-in-out infinite; }
  @keyframes blink { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .dot { animation: none; } }
  .actions { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.5rem !important; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
</style>
