---
import { SITE } from '../site';
---

<footer>
  <div class="container">
    <span class="muted">© {new Date().getFullYear()} {SITE.name} · Built with <a class="plain" href="https://astro.build">Astro</a></span>
    <span class="links">
      <a href={SITE.github}>GitHub</a>
      <a href={SITE.linkedin}>LinkedIn</a>
      <a href="#" aria-label="Back to top">Top ↑</a>
    </span>
  </div>
</footer>

<style>
  footer {
    --text: #e3e8e2; --muted: #95a198; --accent: #b08d45; --accent-strong: #c6a35a;
    background: var(--bar-sheen), var(--bar);
    border-top: 1px solid var(--bar-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09);
    padding: 0.9rem 0;
    font-size: 0.85rem;
  }
  .container { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
  .links { display: flex; gap: 1rem; }
  .plain { color: inherit; text-decoration: underline; text-decoration-color: var(--bar-line); text-underline-offset: 3px; }
  .plain:hover { color: var(--accent-strong); }
</style>
