---
import { SITE } from '../site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { href: `${base}/about`, label: 'About' },
];
const here = Astro.url.pathname.replace(/\/$/, '');
---

<header>
  <div class="container bar">
    <a class="brand" href={`${base}/`}>{SITE.name}</a>
    <nav>
      {links.map((l) => <a href={l.href} aria-current={here.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <button id="theme-toggle" type="button" aria-label="Switch to light theme" title="Toggle day / night"></button>
    </nav>
  </div>
</header>

<style>
  header {
    /* the bar stays dark gray in both themes, so pin its text colours */
    --text: #e3e8e2; --muted: #95a198; --accent: #b08d45; --accent-strong: #c6a35a;
    background: var(--bar-sheen), var(--bar);
    border-bottom: 1px solid var(--bar-line);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09), 0 6px 18px rgba(0, 0, 0, 0.35);
    margin-bottom: 1.5rem;
    position: sticky; top: 0; z-index: 10;
  }
  .bar { display: flex; justify-content: space-between; align-items: center; padding-top: 0.6rem; padding-bottom: 0.6rem; }
  .brand { font-weight: 700; color: var(--accent); letter-spacing: 0.02em; }
  .brand:hover { color: var(--accent-strong); text-decoration: none; }
  nav { display: flex; gap: 1.25rem; align-items: center; }
  #theme-toggle {
    width: 1.8rem; height: 1.8rem; border-radius: 50%; padding: 0; cursor: pointer; line-height: 1;
    background: rgba(255, 255, 255, 0.04); color: var(--muted); border: 1px solid #34383b; font-size: 0.9rem;
    transition: color 0.15s, border-color 0.15s;
  }
  #theme-toggle:hover { color: var(--accent-strong); border-color: var(--accent); }
  #theme-toggle::before { content: '\2600'; } /* sun: shown in the dark theme, click for daylight */
  :global(:root[data-theme='light']) #theme-toggle::before { content: '\263E'; } /* moon */
  nav a { color: var(--muted); }
  nav a:hover { color: var(--accent-strong); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--text); box-shadow: 0 1px 0 var(--accent); }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => btn?.setAttribute('aria-label', root.dataset.theme === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
  sync();
  btn?.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
    try { localStorage.setItem('theme', light ? 'light' : 'dark'); } catch (e) {}
    sync();
  });
</script>
