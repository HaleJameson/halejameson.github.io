<style>
  .atmosphere { position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; }
  .moon {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 38% 30% at 78% 6%, var(--sky-light), transparent 70%),
      radial-gradient(ellipse 70% 40% at 50% 100%, var(--sky-glow), transparent 70%);
  }
  .crescent { position: absolute; top: 4%; right: 14%; width: clamp(56px, 7vw, 96px); transform: rotate(-18deg);
              filter: drop-shadow(0 0 10px rgba(200, 225, 215, 0.55)) drop-shadow(0 0 32px rgba(170, 205, 190, 0.3));
              animation: moonrise 3s ease-out both, moonglow 9s ease-in-out 3s infinite alternate; }
  @keyframes moonrise { from { opacity: 0; transform: translateY(14px) rotate(-18deg); } to { opacity: 1; transform: rotate(-18deg); } }
  @keyframes moonglow {
    from { filter: drop-shadow(0 0 8px rgba(200, 225, 215, 0.45)) drop-shadow(0 0 26px rgba(170, 205, 190, 0.22)); }
    to   { filter: drop-shadow(0 0 16px rgba(215, 235, 225, 0.8)) drop-shadow(0 0 46px rgba(170, 205, 190, 0.45)); }
  }
  .trees { position: absolute; left: 0; bottom: 0; width: 100%; height: 55vh; }
  .trees path { stroke: none; }
  .back path  { fill: var(--tree-back); opacity: 0.85; }
  .mid path   { fill: var(--tree-mid); opacity: 0.95; }
  .front path { fill: var(--tree-front); }
  .back  { height: 48vh; }
  .mid   { height: 52vh; }
  .front { height: 58vh; }
  .fog {
    position: absolute; left: 0; width: calc(100% + 1200px);
    background-repeat: repeat-x; will-change: transform;
    -webkit-mask-image: linear-gradient(to top, #000 25%, transparent 100%);
    mask-image: linear-gradient(to top, #000 25%, transparent 100%);
  }
  .fog-a { bottom: 0; height: 60vh; background-image: var(--fog-a); background-size: 1200px 100%; opacity: 0.5;
            animation: drift 150s linear infinite; }
  .fog-b { bottom: 0; height: 38vh; background-image: var(--fog-b); background-size: 1200px 100%; opacity: 0.38;
            animation: drift 95s linear infinite reverse; }
  @keyframes drift { from { transform: translateX(0); } to { transform: translateX(-1200px); } }
  :global(:root[data-theme='light']) .crescent { display: none; }
  :global(:root[data-theme='light']) canvas { display: none; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .grain { position: absolute; inset: 0; background-image: var(--grain); opacity: 0.07; mix-blend-mode: overlay; }
  .vignette { position: absolute; inset: 0; background: radial-gradient(ellipse at 50% 40%, transparent 45%, var(--vignette) 100%); }
  @media (prefers-reduced-motion: reduce) { .fog { animation: none; } .crescent { animation: none; } }
</style>

<script>
  // Light rain plus a few drifting fireflies. Skipped entirely for reduced-motion users.
  const canvas = document.getElementById('weather') as HTMLCanvasElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (canvas && !reduce) {
    const ctx = canvas.getContext('2d')!;
    let w = 0, h = 0;
    type Drop = { x: number; y: number; len: number; v: number };
    type Fly = { x: number; y: number; vx: number; vy: number; ph: number };
    let drops: Drop[] = [];
    let flies: Fly[] = [];
    const wind = 0.22;
    // Fireflies drift gently toward the cursor when it is nearby.
    let mx = -9999, my = -9999;
    window.addEventListener('mousemove', (e) => { mx = e.clientX; my = e.clientY; });
    window.addEventListener('mouseout', (e) => { if (!e.relatedTarget) { mx = -9999; my = -9999; } });
    const root = document.documentElement;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(160, Math.max(60, (w * h) / 11000)));
      drops = Array.from({ length: count }, () => ({
        x: Math.random() * (w + 200) - 100, y: Math.random() * h,
        len: 10 + Math.random() * 14, v: 11 + Math.random() * 8,
      }));
      flies = Array.from({ length: w < 700 ? 8 : 16 }, () => ({
        x: Math.random() * w, y: h * (0.45 + Math.random() * 0.5),
        vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.18, ph: Math.random() * 6.28,
      }));
    };
    resize();
    window.addEventListener('resize', resize);

    const frame = (t: number) => {
      ctx.clearRect(0, 0, w, h);
      if (root.dataset.theme === 'light') { requestAnimationFrame(frame); return; }
      ctx.lineWidth = 1;
      ctx.strokeStyle = 'rgba(175, 205, 190, 0.22)';
      ctx.beginPath();
      for (const d of drops) {
        ctx.moveTo(d.x, d.y);
        ctx.lineTo(d.x + d.len * wind, d.y + d.len);
        d.y += d.v; d.x += d.v * wind;
        if (d.y > h) { d.y = -d.len; d.x = Math.random() * (w + 200) - 100; }
      }
      ctx.stroke();
      for (const f of flies) {
        f.x += f.vx + Math.sin(t / 2200 + f.ph) * 0.2;
        f.y += f.vy + Math.cos(t / 1900 + f.ph) * 0.15;
        const dx = mx - f.x, dy = my - f.y, dist = Math.hypot(dx, dy);
        if (dist < 220 && dist > 30) { f.x += dx * 0.012; f.y += dy * 0.012; }
        if (f.x < -10) f.x = w + 10; if (f.x > w + 10) f.x = -10;
        if (f.y < h * 0.35) f.vy = Math.abs(f.vy); if (f.y > h) f.vy = -Math.abs(f.vy);
        const a = 0.25 + 0.75 * (0.5 + 0.5 * Math.sin(t / 700 + f.ph));
        const g = ctx.createRadialGradient(f.x, f.y, 0, f.x, f.y, 9);
        g.addColorStop(0, `rgba(226, 190, 90, ${0.85 * a})`);
        g.addColorStop(1, 'rgba(226, 190, 90, 0)');
        ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(f.x, f.y, 9, 0, 6.283); ctx.fill();
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>
